{
  "name": "ch-service-risk",
  "version": "0.2.0",
  "private": true,
  "description": "Offline risk-parameter calibration and crash-replay backtest for Clearinghouse. Reads committed CSVs only: no network, no keys.",
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/services/risk/src/risk.test.js dist/services/risk/src/backtest.test.js dist/services/risk/src/frontier.test.js",
    "calibrate": "tsc && node dist/services/risk/src/cli.js calibrate",
    "backtest": "tsc && node dist/services/risk/src/cli.js backtest",
    "frontier": "tsc && node dist/services/risk/src/cli.js frontier"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.9.3"
  }
}
